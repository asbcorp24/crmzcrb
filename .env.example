APP_NAME="CRM"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
LOG_CHANNEL=stack
LOG_LEVEL=debug
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=crmzcrb
DB_USERNAME=root
DB_PASSWORD=
BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# При первой multi-tenant миграции существующие данные попадут в эту организацию
APP_ORGANIZATION_NAME="Основная организация"
APP_ORGANIZATION_SHORT_NAME="Организация"
APP_ORGANIZATION_CODE=main

# PWA Web Push (сгенерировать: php artisan crm:vapid-keys)
VAPID_SUBJECT=http://localhost
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
